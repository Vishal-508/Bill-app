<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <style>
    @page {
      size: A4;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Helvetica', Arial, sans-serif;
      font-size: 12px;
      color: #333;
      padding: 20mm;
      line-height: 1.5;
    }

    .header {
      text-align: center;
      border-bottom: 2px solid #2c3e50;
      padding-bottom: 15px;
      margin-bottom: 20px;
    }

    h1 {
      color: #2c3e50;
      font-size: 24px;
      margin-bottom: 5px;
    }

    .subtitle {
      color: #7f8c8d;
      font-size: 14px;
    }

    .info-section {
      background: #f8f9fa;
      padding: 15px;
      border-radius: 5px;
      margin-bottom: 20px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 5px 0;
    }

    .info-label {
      font-weight: bold;
      color: #2c3e50;
    }

    .test-data {
      margin: 20px 0;
    }

    .test-data h3 {
      color: #2c3e50;
      margin-bottom: 10px;
      font-size: 16px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 10px 0;
    }

    th {
      background: #2c3e50;
      color: white;
      padding: 8px;
      text-align: left;
    }

    td {
      padding: 8px;
      border-bottom: 1px solid #ecf0f1;
    }

    .currency {
      text-align: right;
      font-family: 'Courier New', monospace;
    }

    .total-row {
      background: #ecf0f1;
      font-weight: bold;
    }

    .footer {
      margin-top: 40px;
      text-align: center;
      color: #7f8c8d;
      font-size: 10px;
      border-top: 1px solid #ecf0f1;
      padding-top: 10px;
    }

    .badge {
      display: inline-block;
      padding: 3px 8px;
      background: #3498db;
      color: white;
      border-radius: 3px;
      font-size: 10px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>{{title}}</h1>
    <div class="subtitle">{{subtitle}}</div>
  </div>

  <div class="info-section">
    <div class="info-row">
      <span class="info-label">Generated:</span>
      <span>{{formatDate generatedAt}}</span>
    </div>
    <div class="info-row">
      <span class="info-label">Test Number:</span>
      <span>{{testNumber}}</span>
    </div>
    <div class="info-row">
      <span class="info-label">Engine:</span>
      <span><span class="badge">Puppeteer</span> + <span class="badge">Handlebars</span></span>
    </div>
  </div>

  <div class="test-data">
    <h3>Sample Items (currency + table rendering test)</h3>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Description</th>
          <th>Qty</th>
          <th class="currency">Rate</th>
          <th class="currency">Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>{{inc @index}}</td>
          <td>{{this.description}}</td>
          <td>{{this.qty}}</td>
          <td class="currency">&#8377; {{formatCurrency this.rate}}</td>
          <td class="currency">&#8377; {{formatCurrency this.amount}}</td>
        </tr>
        {{/each}}
        <tr class="total-row">
          <td colspan="4" style="text-align: right;">TOTAL</td>
          <td class="currency">&#8377; {{formatCurrency total}}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="test-data">
    <h3>Amount in Words</h3>
    <p style="font-style: italic; padding: 10px; background: #fef9e7;">
      {{amountInWords}}
    </p>
  </div>

  <div class="footer">
    PDF Generation Test &bull; Shree Gopal MDF &bull; Indore, MP
    <br>
    This is a test document &mdash; not an actual invoice
  </div>
</body>
</html>
