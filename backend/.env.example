# ════════════════════════════════════════════════════════════════
#  Shree Gopal MDF — Backend Environment Variables
#  Copy this file to `.env` and fill in real values for local dev.
#  Never commit `.env` to git.
# ════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
# Node environment: development | production | test
NODE_ENV=development
# Port the Express server listens on
PORT=5000

# ── Database ────────────────────────────────────────────────────
# MongoDB connection string (local or Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/shree_gopal_mdf

# ── JWT ─────────────────────────────────────────────────────────
# Secret used to sign short-lived access tokens (use a long random string)
JWT_SECRET=replace-with-a-long-random-string
# Secret used to sign long-lived refresh tokens (different from JWT_SECRET)
JWT_REFRESH_SECRET=replace-with-another-long-random-string
# Access token lifetime (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1d
# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URLs (used for CORS + email/WhatsApp links) ────────
# URL of the admin dashboard Vite app
FRONTEND_ADMIN_URL=http://localhost:5173
# URL of the customer-facing Vite app
FRONTEND_CUSTOMER_URL=http://localhost:5174

# ── Razorpay ────────────────────────────────────────────────────
# Razorpay public key id (rzp_test_… or rzp_live_…)
RZP_KEY_ID=
# Razorpay secret key — NEVER expose to the frontend
RZP_KEY_SECRET=
# Webhook signing secret configured in the Razorpay dashboard
RZP_WEBHOOK_SECRET=

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────
# Permanent access token from Meta for Developers
WA_TOKEN=
# Phone number id of the WhatsApp Business account
WA_PHONE_ID=
# Verify token used by Meta to verify the webhook URL
WA_VERIFY_TOKEN=
# WhatsApp Business Account (WABA) id
WA_BUSINESS_ACCOUNT_ID=
# Graph API version to call (e.g. v23.0)
WA_API_VERSION=v23.0

# ── Merchant details (printed on invoices, UPI QR, etc.) ────────
# Merchant UPI VPA (e.g. shop@upi)
MERCHANT_VPA=
# Legal business name as it should appear on invoices
MERCHANT_NAME=Shree Gopal MDF
# Merchant GSTIN (15-character GST number)
MERCHANT_GSTIN=
# Two-digit GST state code (e.g. 09 for Uttar Pradesh)
MERCHANT_STATE_CODE=
# Merchant address line 1 (shop number / street)
MERCHANT_ADDRESS_LINE1=
# Merchant address line 2 (area / landmark)
MERCHANT_ADDRESS_LINE2=
# Merchant city
MERCHANT_CITY=
# Merchant state (full name)
MERCHANT_STATE=
# Merchant pincode (6 digits)
MERCHANT_PINCODE=
# Merchant phone number shown on bills (with country code)
MERCHANT_PHONE=

# ── Cloudinary (image hosting) ──────────────────────────────────
# Cloudinary cloud name (from the dashboard)
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key
CLOUDINARY_API_KEY=
# Cloudinary API secret — keep server-side only
CLOUDINARY_API_SECRET=

# ── Email (Nodemailer SMTP) ─────────────────────────────────────
# SMTP host (e.g. smtp.gmail.com, smtp.sendgrid.net)
EMAIL_HOST=smtp.gmail.com
# SMTP port (587 for STARTTLS, 465 for SSL)
EMAIL_PORT=587
# SMTP username / account
EMAIL_USER=
# SMTP password or app-specific password
EMAIL_PASS=
# Default From address shown on outgoing email
EMAIL_FROM="Shree Gopal MDF <noreply@example.com>"

# ── Seed admin account (used by scripts/seed) ───────────────────
# Email of the first admin user created on seed
SEED_ADMIN_EMAIL=admin@example.com
# Initial password for the seed admin (change after first login)
SEED_ADMIN_PASSWORD=changeme123
# Display name for the seed admin
SEED_ADMIN_NAME=Admin
