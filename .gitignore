# ── Dependencies ──────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Environment files ─────────────────────────────────────────
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# ── Build output ──────────────────────────────────────────────
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# ── Vite ──────────────────────────────────────────────────────
.vite/
**/.vite/

# ── Testing / coverage ────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors / IDEs ────────────────────────────────────────────
.idea/
.vscode/settings.json
.claude/settings.local.json
*.swp
*.swo
*~

# ── Runtime / generated content ───────────────────────────────
uploads/
temp/
generated-pdfs/
**/uploads/
**/temp/
**/generated-pdfs/

# ── Generated bill PDFs (recreatable from data) ───────────────
backend/storage/bills/*.pdf
**/storage/bills/*.pdf
backend/storage/temp/
**/storage/temp/
!**/storage/bills/.gitkeep
!**/storage/temp/.gitkeep

# ── QR code samples (test artifacts) ──────────────────────────
backend/storage/qr-samples/*.png
backend/storage/qr-samples/*.svg
!backend/storage/qr-samples/.gitkeep

# ── Payment receipts (generated PDFs) ─────────────────────────
backend/storage/receipts/*.pdf
!backend/storage/receipts/.gitkeep

# ── Excel / source data (keep folder, ignore files) ───────────
data/*.xlsx
data/*.xlsm
**/data/*.xlsx
**/data/*.xlsm
!**/data/.gitkeep

# ── Backend runtime logs ──────────────────────────────────────
backend/logs/

# ── Misc ──────────────────────────────────────────────────────
*.local
.cache/
